# Configurações Gerais
PORT=5000
DATABASE_URL="postgresql://usuario:senha@host:porta/banco?sslmode=require"
JWT_SECRET="sua_chave_secreta_jwt_aqui"

# Provedores de Inteligência Artificial
GEMINI_API_KEY="SUA_CHAVE_API_DO_GEMINI_AQUI"
GROQ_API_KEY="SUA_CHAVE_API_DO_GROQ_AQUI"

# Executável do Python (opcional, para scripts locais)
PYTHON_PATH="python"

# Configurações de TTS (Text-To-Speech)
TTS_DEFAULT_VOICE="pt-BR-FranciscaNeural"

# Banco de Dados Vetorial (Pinecone - RAG de Livros/Artigos)
PINECONE_API_KEY="SUA_CHAVE_API_DO_PINECONE_AQUI"
PINECONE_INDEX="psai"
PINECONE_NAMESPACE="psai"

# ASAAS (Gateway de Pagamentos - Pix/Boleto)
ASAAS_ENV="sandbox"
ASAAS_API_KEY="SUA_CHAVE_API_DO_ASAAS_AQUI"
ASAAS_WEBHOOK_TOKEN="SEU_TOKEN_WEBHOOK_DO_ASAAS_AQUI"

# ElevenLabs (Síntese de Voz Avançada)
ELEVENLABS_API_KEY="SUA_CHAVE_API_DA_ELEVENLABS_AQUI"
ELEVENLABS_DEFAULT_VOICE_ID="id_da_voz_aqui"
